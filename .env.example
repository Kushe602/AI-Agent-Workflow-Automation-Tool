# Copy to .env and fill in. Nothing here is required to run the fake agent.

# Your Anthropic API key. Leave blank to run in deterministic fake-agent mode.
ANTHROPIC_API_KEY=

# Secret for signing JWT session cookies (use >=32 random bytes in production).
SECRET_KEY=change-me-to-a-long-random-secret-value-32b

# Database URL. Default is local SQLite; docker-compose overrides with Postgres.
DATABASE_URL=sqlite+aiosqlite:///./agentflow.db

# Claude model used to drive the agent loop.
CHAT_MODEL=claude-sonnet-5

# Set to 1 to force the fake agent even when an API key is present.
USE_FAKE_AGENT=0

# Safety limits for the agent loop and tools.
MAX_ITERATIONS=8
TOOL_TIMEOUT_SECONDS=15
